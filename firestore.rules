rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir su propio documento y subcolecciones
    // (users/{uid}, users/{uid}/cards, users/{uid}/games, users/{uid}/sessions).
    // Los invitados no tienen sesión, así que no pueden acceder a nada.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
